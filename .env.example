# ─── Supabase ───────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx   # or the legacy anon JWT
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx            # or the legacy service_role JWT

# ─── AI providers (optional; configure multiple for failover) ─
# Clear, complete text can be extracted locally without an AI request.
# For incomplete text or image-only posts, configured providers are tried in order:
# Gemini → OpenRouter → Groq. Each has separate free-tier/quota limits; availability
# is not guaranteed. If all fail, the app keeps its offline extraction/OCR result.

# 1) Google AI Studio — https://aistudio.google.com/apikey
#    Note: some Google Cloud projects have no free tier and return 403.
GEMINI_API_KEY=

# 2) OpenRouter — https://openrouter.ai/keys
#    "openrouter/free" is a router that always picks a live free model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional: set a separate model if your preferred router is not vision-capable.
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free

# 3) Groq (not xAI Grok) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional: force a single provider (gemini | openrouter | groq), which disables
# cross-provider fallback. Leave empty to try every configured provider.
AI_PROVIDER=

# Required only if API keys are managed from the in-app Settings page.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this stable and backed up; changing it makes stored provider keys unreadable.
AI_KEYS_ENCRYPTION_KEY=

# ─── Browser extension ──────────────────────────────────────
# Long random string. The extension sends it as a Bearer token.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXTENSION_TOKEN=change-me-to-a-long-random-string

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
