# ─── Supabase ───────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx   # or the legacy anon JWT
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx            # or the legacy service_role JWT

# ─── AI (pick ONE, all free, no card) ───────────────────────
# The app tries whichever keys exist, in this order: Gemini → OpenRouter → Groq.
# If none work it falls back to a built-in offline regex parser.

# 1) Google AI Studio — https://aistudio.google.com/apikey
#    Note: some Google Cloud projects have no free tier and return 403.
GEMINI_API_KEY=

# 2) OpenRouter — https://openrouter.ai/keys  (works in BD, free models)
#    "openrouter/free" is a router that always picks a live free model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# 3) Groq — https://console.groq.com/keys  (very fast, free vision models)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional: force a single provider (gemini | openrouter | groq). Empty = auto.
AI_PROVIDER=

# ─── Browser extension ──────────────────────────────────────
# Long random string. The extension sends it as a Bearer token.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXTENSION_TOKEN=change-me-to-a-long-random-string

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
