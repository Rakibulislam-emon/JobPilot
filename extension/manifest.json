{
  "manifest_version": 3,
  "name": "JobDesk Capture",
  "version": "1.0.1",
  "description": "Capture any job post — BDJobs, LinkedIn, Facebook groups — straight into your JobDesk tracker.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["http://localhost:3000/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture to JobDesk (Alt+Shift+J)"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+J",
        "mac": "Alt+Shift+J"
      },
      "description": "Capture this page to JobDesk"
    }
  }
}
